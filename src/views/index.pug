block variables 

doctype html 
html(lang="en")
  head 
    include layouts/head.pug

  include layouts/preloader.pug
  include layouts/scrollbar.pug
  include layouts/cursor.pug

  body
    .content#content(data-template=template)
      block content
  .canvas

  if isProduction 
    script(type="module", src="main.js")
  else
    script(type="module", src="/src/app/index.js")
