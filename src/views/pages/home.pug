extends ../index.pug 
include ../mixins/icons.pug

block variables 
  - var template = 'home'

block content
  .home
    section.hero 
      .hero__top
        +title()
        .hero__sub 
          h2.hero__sub__title.h3 Smooth Scroll
          h2.hero__sub__text © 2024 darkroom.engineering
      .hero__bottom 
        .hero__scroll 
          .hero__scroll__text 
            p scroll 
            p to explore
        h1.hero__description 
          | A smooth scroll library
          br
          | fresh out of darkroom.engineering
          br
          | website designed by Studio Freight
        a.button(href="https://github.com/darkroomengineering/lenis")
          span.button__icon 
            +github()
          span.button__text
            span.button__text__visible
              | Check it out on github
              +diagonal-arrow()
            span.button__text__hidden
              | Check it out on github
              +diagonal-arrow()
    section.why 
      .why__grid 
        h2.why__sticky Why smooth scroll?  
        aside.why__features
          each item in why_features
            .why__feature
              if item.title
                h3=item.title 
              p=item.text
    section.rethink 
      .rethink__grid 
        .rethink__highlight 
          h2.rethink__highlight__title(data-animation="parallax" data-speed=-0.5) Rethinking smooth scroll
        .rethink__comparison
          p.rethink__comparison__text(data-animation="parallax" data-speed=0.5)
            | We have to give props to libraries like&nbsp;
            a(href="https://github.com/locomotivemtl/locomotive-scroll") Locomotive Scroll
            | &nbsp;and 
            a(href="https://github.com/locomotivemtl/locomotive-scroll") GSAP ScrollSmoother
            | . They’re well built and well documented – and we’ve used them a lot. But they still have issues that keep them from being bulletproof.
      .rethink__cards
        .rethink__cards__wrapper
          .rethink__cards__inner 
            .rethink__cards__overflow 
              each item, index in rethink_cards
                .rethink__card
                  p.rethink__card__number=`0${index +1}`
                  p.rethink__card__text=item
    section.solution 
      .solution__inner 
        .solution__zoom 
          h2.solution__zoom__first 
            | so we built 
            br
            span.contrast web scrolling
          h2.solution__zoom__enter
            | Enter
            br
            | Lenis
          h2.solution__zoom__second As it should be
    section.featuring 
      .featuring__inner 
        .featuring__intro 
          p 
            | Lenis is an 
            a(href="")  open-source library
            |  built to standardize scroll experiences and sauce up websites with butter-smooth navigation, all while using the platform and keeping it accessible.
      .featuring__section 
        .featuring__cards 
          .featuring__cards__sticky
            aside.featuring__cards__title 
              p 
                | Lenis brings
                br
                span.grey the heat
            .featuring__cards__list 
              each item, index in featurings_cards
                .featuring__cards__item 
                  .featuring__cards__item__wrapper
                    p.featuring__cards__item__number=`0${index + 1}`
                    p.featuring__cards__item__text!=item.text.replace(/\n/g, '<br>')
    section.in__use 
      .in__use__wrapper 
        aside.in__use__title 
          p 
            | Lenis 
            br
            span.grey in use 
        ul.in__use__list 
          each item in in_use
            li
              a.in__use__item(href=item.href) 
                .in__use__item__inner 
                  .in__use__item__title
                    span=item.title 
                    +diagonal-arrow-big()
                  .in__use__item__source 
                    span=item.source
    footer.footer 
      .footer__top 
        p.footer__first 
          | Lenis is 
          br
          span.contrast Open source
        p.footer__last & open to features, forks or prs
        a.button(href="https://github.com/darkroomengineering/lenis")
          span.button__icon 
            +github()
          span.button__text
            span.button__text__visible
              | Let's build together
              +diagonal-arrow()
            span.button__text__hidden
              | Let's build together
              +diagonal-arrow()
      .footer__bottom 
        .footer__links 
          a.footer__link(href="https://twitter.com/darkroomdevs") Twitter
          a.footer__link(href="https://github.com/darkroomengineering") GitHub
          a.footer__link(href="https://darkroom.engineering/") Website
          a.footer__link(href="https://studiofreight.com") Designed by Studio Freight
        p.footer__tm 
          span ©
          | 2024  darkroom.engineering
